VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VK ID (id.vk.com → ваше приложение)
VITE_VK_APP_ID=
# Должен посимвольно совпадать с «Доверенным Redirect URL» в кабинете VK ID
VITE_VK_REDIRECT_URL=https://localhost/auth/vk

# true — сайт открыт только пользователям из таблицы admins (кроме /results)
VITE_ADMIN_ONLY=true

# Необязательно: адрес функций загрузки. По умолчанию <VITE_SUPABASE_URL>/functions/v1
VITE_UPLOAD_API_URL=

# Окончание приёма работ (с часовым поясом). Пусто — приём открыт
VITE_SUBMISSION_DEADLINE=
